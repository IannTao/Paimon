# Project-local authorization from AGENTS.md. Keep the executable paths exact.
# Do not replace this with a blanket shell or PowerShell allow rule.
prefix_rule(
    pattern = [[
        "C:/Users/tyc/code/dev-tools/android-sdk/platform-tools/adb.exe",
        "C:\\Users\\tyc\\code\\dev-tools\\android-sdk\\platform-tools\\adb.exe",
    ]],
    decision = "allow",
    justification = "User authorizes ADB operations within the Paimon project task scope in AGENTS.md.",
    match = [
        "C:/Users/tyc/code/dev-tools/android-sdk/platform-tools/adb.exe devices -l",
        "C:/Users/tyc/code/dev-tools/android-sdk/platform-tools/adb.exe -s D123133103AF shell wm size",
        "C:/Users/tyc/code/dev-tools/android-sdk/platform-tools/adb.exe install -r android/app/build/outputs/apk/debug/app-debug.apk",
    ],
    not_match = [
        "adb devices -l",
        "C:/other/adb.exe devices -l",
        "C:/Users/tyc/code/dev-tools/android-sdk/platform-tools/adb.exe.bak devices -l",
        "pwsh -Command whoami",
    ],
)
